{
    "cli": {
        "appVersionSource": "remote"
    },
    "build": {
        "production": {
            "autoIncrement": true,
            "android": {
                "buildType": "apk"
            }
        },
        "development": {
            "developmentClient": false,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleDebug"
            }
        }
    }
}
