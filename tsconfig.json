{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "background-agent-service": [
        "./modules/background-agent-service/index.ts"
      ],
      "scheduler-alarm": ["./modules/scheduler-alarm/index.ts"],
      "process-text": ["./modules/process-text/index.ts"],
      "saf-file-operations": ["./modules/saf-file-operations/index.ts"],
      "termux-stream": ["./modules/termux-stream/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "plugins/**/*.js",
    "scripts/**/*.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "desktop", "oauth-proxy"]
}
